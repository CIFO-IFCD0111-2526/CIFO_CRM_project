<div class="page-header">
  <div>
    <h1 class="page-title">Usuaris pendents d'activació</h1>
    <p class="page-subtitle">Llistat d'usuaris que han sol·licitat l'activació del perfil</p>
  </div>
</div>

<% if (pagination && pagination.totalItems > 0) { %>
  <div class="tabla-container">
    <table id="alumnosTable">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Cognoms</th>
          <th>Email</th>
          <th>Data de registre</th>
          <th class="col-accions">Accions</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(usuarioItem => { %>
          <tr>
            <td>
              <a class="alumno-nombre" href="/usuarios/<%= usuarioItem.id %>">
                <%= usuarioItem.nombre %>
              </a>
            </td>
            <td><%= usuarioItem.apellidos || '—' %></td>
            <td><%= usuarioItem.email || '—' %></td>
            <td class="col-fecha">
              <%= usuarioItem.createdAt
                ? new Date(usuarioItem.createdAt).toLocaleDateString('ca-ES', { day: '2-digit', month: '2-digit', year: 'numeric' })
                : '—'
              %>
            </td>
            <td class="col-accions">
              <div class="acciones">
                <select class="select-rol" id="rol-<%= usuarioItem.id %>">
                  <option value="lector">Lector</option>
                  <option value="editor">Editor</option>
                  <option value="admin">Admin</option>
                </select>
              
                <button class="btn btn-secundario" onclick="aprovarUsuario('<%= usuarioItem.id %>')">
                  Aprovar
                </button>
              
                <button class="btn btn-secundario" onclick="rebutjarUsuario('<%= usuarioItem.id %>')">
                  Rebutjar
                </button>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <div class="pagination-wrapper">
      <div class="pagination" aria-label="Paginació">
        <% if (pagination.currentPage > 1) { %>
          <a href="?page=<%= pagination.currentPage - 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            ← Anterior
          </a>
        <% } %>

        <span class="pagination-info">
          Pàgina <%= pagination.currentPage %> de <%= pagination.totalPages %>
          (<%= pagination.totalItems %> usuaris)
        </span>

        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="?page=<%= pagination.currentPage + 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            Següent →
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

<% } else { %>
  <div class="empty-state">
    <p>No hi ha usuaris pendents.</p>
  </div>
<% } %>

<hr style="margin: 3rem 0;">

<div class="page-header">
  <div>
    <h1 class="page-title">Usuaris actius</h1>
    <p class="page-subtitle">
      Llistat d'usuaris aprovats al sistema
    </p>
  </div>
</div>

<div class="tabla-container">
  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Cognoms</th>
        <th>Email</th>
        <th>Rol</th>
        <th>Accions</th>
      </tr>
    </thead>

    <tbody>
      <% usuariosActivos.forEach(usuarioItem=> { %>
        <tr>
          <td>
            <%= usuarioItem.nombre %>
          </td>
          <td>
            <%= usuarioItem.apellidos %>
          </td>
          <td>
            <%= usuarioItem.email %>
          </td>
          <td>
            <select class="select-rol" id="rol-activo-<%= usuarioItem.id %>">
              <option value="lector" <%=usuarioItem.nivel_acceso==="lector" ? "selected" : "" %>>
                Lector
              </option>

              <option value="editor" <%=usuarioItem.nivel_acceso==="editor" ? "selected" : "" %>>
                Editor
              </option>

              <option value="admin" <%=usuarioItem.nivel_acceso==="admin" ? "selected" : "" %>>
                Admin
              </option>
            </select>
          </td>
          <td>
            <button class="btn btn-secundario" onclick="actualitzarRol('<%= usuarioItem.id %>')">
              Guardar
            </button>
          </td>
        </tr>
        <% }) %>
    </tbody>

  </table>
</div>
