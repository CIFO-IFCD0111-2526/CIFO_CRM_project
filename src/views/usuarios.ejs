<% var styles='<link rel="stylesheet" href="/css/usuarios.css">' %>

<div class="page-header">
    ...

<div class="page-header">
    <div>
        <a href="/dashboard" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Tornar al dashboard
        </a>

        <h1 class="page-title">Administració d'usuaris</h1>
        <p class="page-subtitle">Gestió de rols, activació i permisos</p>
    </div>
</div>

<div class="detalle-grid">

    <section class="detalle-card">
        <h2 class="detalle-card-title">Llista d'usuaris</h2>

        <table class="tabla">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Nivell d'accés</th>
                    <th>Estat</th>
                    <th>Accions</th>
                </tr>
            </thead>

            <tbody>
                <% usuaris.forEach(u => { %>
                <tr data-id="<%= u.id %>">

                    <td><%= u.nombre %> <%= u.apellidos %></td>

                    <td><%= u.email %></td>

                    <td>
                        <!-- DROPDOWN DE ROLS -->
                        <select class="select-rol">
                            <option value="admin" <%= u.nivel_acceso === 'admin' ? 'selected' : '' %>>Admin</option>
                            <option value="editor" <%= u.nivel_acceso === 'editor' ? 'selected' : '' %>>Editor</option>
                            <option value="lector" <%= u.nivel_acceso === 'lector' ? 'selected' : '' %>>Lector</option>
                        </select>
                    </td>

                    <td>
                        <% if (u.estado === 'pendiente') { %>
                            <span class="badge badge-futuro">Pendent</span>
                        <% } else { %>
                            <span class="badge badge-actual">Actiu</span>
                        <% } %>
                    </td>

                    <td>
                        <% if (u.estado === 'pendiente') { %>
                            <button class="btn btn-primario btn-aprovar">Aprovar</button>
                        <% } %>

                        <button class="btn btn-peligro btn-eliminar">Eliminar</button>
                    </td>

                </tr>
                <% }) %>
            </tbody>
        </table>
    </section>

</div>

<script src="/js/usuarios.js"></script>
