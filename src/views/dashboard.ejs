<!-- <div class="dashboard-card anotaciones-card"> -->
<div class="dashboard-card-title">
  <h2 class="dashboard-card-title-anotacions">Anotacions</h2>

<div class="dashboard-card-header">
    
  </div>

  <form id="anotacionForm" class="anotacion-form">

    <textarea
      name="contenido"
      id="contenidoAnotacio"
      placeholder="Escriu una anotació..."
      rows="3"
    ></textarea>

    

  </form>
</section>

<div class="mostra-notes">


  <div class="notes-header">
    <h3 class="notes-title">Les meves anotacions</h3>

  </div>

  <% if (anotaciones && anotaciones.length> 0) { %>

    <ul class="anotaciones-list">
      <% anotaciones.forEach(a=> { %>
        <li class="anotacion-item">

          <div class="anotacion-texto">
            <%= a.contenido %>
          </div>

          <div class="anotacion-fecha col-fecha">
            <%= a.createdAt ? new Date(a.createdAt).toLocaleDateString('ca-ES', { day: '2-digit' , month: '2-digit' ,
              year: 'numeric' }) : '—' %>
          </div>

        </li>
        <% }) %>
    </ul>

    <% } else { %>

      <div class="empty-state">
        <p>No hi ha anotacions encara.</p>
      </div>

      <% } %>

        <!-- PAGINACIÓN -->
        <% if (pagination && pagination.totalPages> 1) { %>

          <div class="pagination-wrapper">
            <div class="pagination">

              <% if (pagination.currentPage> 1) { %>
                <a href="/dashboard?page=<%= pagination.currentPage - 1 %>" class="btn btn-secundario btn-sm">
                  ← Anterior
                </a>
                <% } %>

                  <span class="pagination-info">
                    Página <%= pagination.currentPage %> de <%= pagination.totalPages %>
                  </span>

                  <% if (pagination.currentPage < pagination.totalPages) { %>
                    <a href="/dashboard?page=<%= pagination.currentPage + 1 %>" class="btn btn-secundario btn-sm">
                      Següent →
                    </a>
                    <% } %>

            </div>
          </div>

          <% } %>

</div>