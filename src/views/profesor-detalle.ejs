<form id="profesorDetalleForm" data-id="<%= profesor.id %>" novalidate>

  <div class="page-header">
    <div>
      <a href="/profesores" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Tornar al llistat
      </a>

      <h1 class="page-title form-group">
        <span class="view-mode">
          <%= profesor.nombre %> <%= profesor.apellidos %>
        </span>
        <div class="edit-mode hidden form-group">
          <input type="text" name="nombre" value="<%= profesor.nombre %>" placeholder="Nom" required />
          <input type="text" name="apellidos" value="<%= profesor.apellidos %>" placeholder="Cognoms" required />
        </div>
      </h1>
    </div>

    <div class="acciones">
      <a href="#" id="btnEditar" class="btn btn-secundario">Editar</a>
      <button type="submit" id="btnGuardar" class="btn btn-secundario edit-mode hidden">Guardar</button>
      <button type="button" id="btnCancelar" class="btn btn-secundario edit-mode hidden">Cancel·lar</button>
      <button type="button" class="btn btn-danger btn-eliminar" data-id="<%= profesor.id %>">Eliminar</button>
    </div>
  </div>

  <div class="detalle-grid form-group">

    <section class="detalle-card">
      <h2 class="detalle-card-title">Dades de contacte</h2>
      <dl class="detalle-list">

        <div class="detalle-item">
          <dt>Email</dt>
          <dd>
            <span class="view-mode"><%= profesor.email %></span>
            <input type="email" name="email" value="<%= profesor.email %>" class="edit-mode hidden" placeholder="Email" required />
          </dd>
        </div>

        <div class="detalle-item">
          <dt>Telèfon</dt>
          <dd>
            <span class="view-mode"><%= profesor.telefono || '—' %></span>
            <input type="tel" name="telefono" value="<%= profesor.telefono %>" class="edit-mode hidden" placeholder="Telèfon" />
          </dd>
        </div>

      </dl>
    </section>

    <div id="profesorDetalleMsg" class="form-msg form-full" aria-live="polite"></div>

    <section class="detalle-card detalle-full">
      <h2 class="detalle-card-title">Cursos que imparteix</h2>
      <% if (profesor.Cursos && profesor.Cursos.length > 0) { %>
        <!-- ordenem  per futurs,presents, passats   -->
        <% profesor.Cursos.sort((a, b) => b.dataValues.estado - a.dataValues.estado) %>
    <ul class="detalle-cursos">
      <% profesor.Cursos.forEach(curso => { %>
            <% console.log("[CRS", curso.dataValues, "::CRS]") 
              let dataInici = curso.fecha_inicio.toLocaleDateString('es-ES')
              let dataFinal = curso.fecha_fin.toLocaleDateString('es-ES')
              // guardem les dates en el format que ens agrada
              let color = "";
            switch (curso.dataValues.estado) {
              case 1:  
                    color = "var(--badge-antiguo-color)";  // passats// passat 
              %> 
              <li>
                <span class="curso-codigo" style="width: 100px;">
                  <%= curso.codigo_curso %>
                </span>
                <span class="curso-codigo" style="width: 100px;">
                  <%= curso.codigo_accion_formativa %>
                </span>
              
                <span class="curso-nombre" style="color:<%= color %>">
                  Finalitzat: <%= dataFinal %>  <%= curso.dataValues.nombre %>
                </span>
              </li>
              <% break;  
              case 2:  
                    color = "var(--color-primario-hover)";%> // EN CURS
              <li>
                <span class="curso-codigo" style="width: 100px;" >
                  <%= curso.codigo_curso %>
                </span>
                <span class="curso-codigo" style="width: 100px;">
                  <%= curso.codigo_accion_formativa %>
                </span>
              
                <span class="curso-nombre" style="color:<%= color %> ">
                  Finalitza <%= dataFinal %>
                </span>
              </li>
              
              <% break;  // en curs 
              case 3:  
                    color = "var(--badge-actual-color)";   
              %>
              <li>
                <span class="curso-codigo" style="width: 120px;" >
                  <%= curso.codigo_curso %>
                </span>
                <span class="curso-codigo" style="width: 120px;">
                  <%= curso.codigo_accion_formativa %>
                </span>
              
                <span class="curso-nombre" style="color:<%= color %> ">
                  Finalitza <%= dataFinal %>
                </span>
              </li>
            <%    
              break;  // pendent iniciar           
              } 
            %>
            
        <li>
          <span class="curso-codigo"><%= curso.codigo_curso %></span>
          <span class="curso-codigo"><%= curso.codigo_accion_formativa %></span>
          <span class="curso-nombre" style="color:<%= color %>">
            <%= curso.dataValues.nombre %> del <%= dataInici %> al <%= dataFinal %>
          </span>
        </li>

      <% }) %>
    </ul>
<% } else { %>
  <p class="detalle-empty">No imparteix cap curs.</p>
<% } %>

    </section>

  </div>
</form>

<!-- 
    color: var(--color-primario);
    background-color: var(--color-primario-suave); -->