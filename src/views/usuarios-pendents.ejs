<div class="page-header">
  <div>
    <h1 class="page-title">Usuaris pendents d'activació</h1>
    <p class="page-subtitle">Llistat d'usuaris que han solicitat l'activació del perfil</p>
  </div>
  <div class="buscador-wrapper">
    <div class="buscador">
      <input type="text" id="busquedaAlumno" placeholder="Buscar usuari..." autocomplete="off" />
    </div>
    <div id="dropdownResultados" class="dropdown hidden"></div>
  </div>
</div>

<% if (pagination && pagination.totalItems > 0) { %>
  <div class="tabla-container">
    <table id="alumnosTable">
      <thead>
        <tr>
          <th>Cognoms, Nom</th>
          <th>Email</th>
          <th>Tipus</th>
          <th>Nivell d'accés</th>
          <th>Data de la petició</th>
          <th class="col-accions">Accions</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(alumno => { %>
          <tr>
            <td>
              <a class="alumno-nombre" href="/usuarios/<%= usuarios.id %>">
                <%= usuarios.apellidos %>, <%= usuarios.nombre %>
              </a>
            </td>
            <td><%= usuarios.email || '—' %></td>
            <td><%= usuarios.nivel_acceso || '—' %></td>
            <td>
              <span class="badge badge-<%= usuarios.nivel_acceso %>">
                <% if (usuarios.nivel_acceso === 'lector') { %>Lector<% } %>
                <% if (usuarios.nivel_acceso === 'editor') { %>Editor<% } %>
              </span>
            </td>
            <td class="col-fecha">
              <%= usuarios.createdAt ? new Date(usuarios.createdAt).toLocaleDateString('ca-ES', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '—' %>
            </td>
            <td class="col-accions">
              <div class="acciones">
                <a href="/usuarios/<%= usuarios.id %>" class="btn btn-secundario btn-sm">Aprovar</a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <div class="pagination-wrapper">
      <div class="pagination" aria-label="Paginació">
        <% if (pagination.currentPage > 1) { %>
          <a href="?page=<%= pagination.currentPage - 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            ← Anterior
          </a>
        <% } %>

        <span class="pagination-info">
          Pàgina <%= pagination.currentPage %> de <%= pagination.totalPages %>
          (<%= pagination.totalItems %> alumnes)
        </span>

        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="?page=<%= pagination.currentPage + 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            Següent →
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

<% } else { %>
  <div class="empty-state">
    <p>No hi ha alumnes registrats.</p>
    <a href="/alumnos/nuevo" class="btn btn-primario">Crear el primer alumne</a>
  </div>
<% } %>
