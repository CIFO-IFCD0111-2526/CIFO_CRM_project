<div class="page-header">
  <div>
    <h1 class="page-title">Professors</h1>
    <p class="page-subtitle">Llistat de professors registrats al centre</p>
  </div>
  <div class="buscador-wrapper">
    <div class="buscador">
      <input type="text" id="busquedaProfesor" placeholder="Buscar professor..." autocomplete="off" />
      <input type="text" id="busquedaProfesor" placeholder="Buscar professor..." autocomplete="off" />
    </div>
    <div id="dropdownResultados" class="dropdown hidden"></div>
  </div>
  <a href="/profesores/nuevo" class="btn btn-primario">Nou professor</a>
</div>

<% if (profesores && profesores.length> 0) { %>
<% if (profesores && profesores.length> 0) { %>
  <div class="tabla-container">
    <table id="profesoresTable">
      <thead>
        <tr>
          <th>Cognoms, Nom</th>
          <th>Email</th>
          <th>Telèfon</th>
          <th>Cursos</th>
          <th class="col-accions">Accions</th>
        </tr>
      </thead>

      <tbody>
        <% profesores.forEach(profesor=> { %>
        <% profesores.forEach(profesor=> { %>
          <tr>
            <td>
              <a class="profesor-nombre" href="/profesores/<%= profesor.id %>">
                <%= profesor.apellidos %>, <%= profesor.nombre %>
              </a>
            </td>

            <td>
              <%= profesor.email || '—' %>
            </td>
            <td>
              <%= profesor.telefono || '—' %>
            </td>
            <td>
              <%= profesor.email || '—' %>
            </td>
            <td>
              <%= profesor.telefono || '—' %>
            </td>

            <td>
              <% if (profesor.Cursos && profesor.Cursos.length> 0) { %>
                <%= profesor.Cursos.map(c=> c.nombre).join(', ') %>
                  <% } else { %>
                    —
                    <% } %>
            </td>

            <td class="col-accions">
              <div class="acciones">
                <a href="/profesores/<%= profesor.id %>" class="btn btn-secundario btn-sm">
                  Editar
                </a>
              </div>
            </td>
          </tr>
          <% }) %>
          <% }) %>
      </tbody>
    </table>
  </div>

  <% if (pagination && pagination.totalItems> 0) { %>
    <div class="pagination-wrapper">
      <div class="pagination" aria-label="Paginació">

        <% if (pagination.currentPage> 1) { %>
          <a href="/profesores?page=<%= pagination.currentPage - 1 %>&limit=<%= pagination.limit %>"
            class="btn btn-secundario btn-sm">
            ← Anterior
          </a>
          <% } %>

            <span class="pagination-info">
              Pàgina <%= pagination.currentPage %> de <%= pagination.totalPages %>
            </span>

            <% if (pagination.currentPage < pagination.totalPages) { %>
              <a href="/profesores?page=<%= pagination.currentPage + 1 %>&limit=<%= pagination.limit %>"
                class="btn btn-secundario btn-sm">
                Següent →
              </a>
              <% } %>

      </div>
    </div>
    <% } %>

      <% } else { %>
        <div class="empty-state">
          <p>No hi ha professors registrats.</p>
          <a href="/profesores/nuevo" class="btn btn-primario">
            Crear el primer professor
          </a>
        </div>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <p>No hi ha professors registrats.</p>
          <a href="/profesores/nuevo" class="btn btn-primario">
            Crear el primer professor
          </a>
        </div>
        <% } %>