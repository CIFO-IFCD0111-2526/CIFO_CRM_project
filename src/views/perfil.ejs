<div class="page-header">
    <div>
        <a href="/dashboard" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Tornar al dashboard
        </a>

        <h1 class="page-title"><%= usuario.nombre %> <%= usuario.apellidos %></h1>

        <p class="page-subtitle">Perfil d'usuari</p>
    </div>
</div>

<div class="detalle-grid">

    <section class="detalle-card">
        <h2 class="detalle-card-title">Dades personals</h2>

        <dl class="detalle-list">
            <div class="detalle-item">
                <dt>Nom</dt>
                <dd><%= usuario.nombre || '—' %></dd>
            </div>

            <div class="detalle-item">
                <dt>Cognoms</dt>
                <dd><%= usuario.apellidos || '—' %></dd>
            </div>

            <div class="detalle-item">
                <dt>Email</dt>
                <dd><%= usuario.email || '—' %></dd>
            </div>

            <!-- <div class="detalle-item">
                <dt>Nivell d'accés</dt>
                <dd>
                    <% if (usuario.nivel_acceso === 'admin') { %>
                        <span class="badge badge-actual">Admin</span>
                    <% } %>
                    <% if (usuario.nivel_acceso === 'editor') { %>
                        <span class="badge badge-futuro">Editor</span>
                    <% } %>
                    <% if (usuario.nivel_acceso === 'lector') { %>
                        <span class="badge badge-antiguo">Lector</span>
                    <% } %>
                </dd>
            </div> Aquesta classe ha d´estar a la gestió dels usuaris -->
        </dl>
    </section>

    <section class="detalle-card">
        <h2 class="detalle-card-title">Canviar contrasenya</h2>

        <form id="perfilPasswordForm" novalidate>
            <div class="form-group">
                <label for="passwordActual">Contrasenya actual</label>
                <input type="password" id="passwordActual" name="passwordActual" required />
            </div>

            <div class="form-group">
                <label for="passwordNova">Contrasenya nova</label>
                <input type="password" id="passwordNova" name="passwordNova" required minlength="6" />
            </div>

            <div class="form-group">
                <label for="passwordConfirmar">Confirmar contrasenya nova</label>
                <input type="password" id="passwordConfirmar" name="passwordConfirmar" required minlength="6" />
            </div>

            <div id="perfilPasswordMsg" class="form-msg" aria-live="polite"></div>

            <button type="submit" class="btn btn-primario">Canviar contrasenya</button>
        </form>
    </section>

</div>
