<div class="page-header">
  <div>
    <h1 class="page-title">Cursos</h1>
    <p class="page-subtitle">Llistat d'cursos registrats al centre</p>
  </div>
  <div class="buscador-wrapper">
    <div class="buscador">
      <input
        type="text"
        id="busquedaCurso"
        placeholder="Buscar curs..."
        autocomplete="off"
      />
    </div>
    <div id="dropdownResultados" class="dropdown hidden"></div>
  </div>
  <a href="/cursos/nuevo" class="btn btn-primario">Nou curs</a>
</div>
<% if (cursos && cursos.length> 0) { %>
  <div class="tabla-container">
    <table id="cursosTable">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Codi del curs</th>
          <th>Codi acció formativa </th>
          <th>Nivell</th>
          <th>Data inici</th>
          <th>Data fi</th>
          <th class="col-accions">Accions</th>
        </tr>
      </thead>
      <tbody>
        <% cursos.forEach(curso=> {%>
          <tr>
            <td>
              <a class="curso-nombre" href="/cursos/<%= curso.id %>">
                <%= curso.nombre %>
              </a>
            </td>
            <td>
              <%= curso.codigo_curso || '—' %>
            </td>
            <td>
              <%= curso.codigo_accion_formativa || '—' %>
            </td>
            <td>
              <%= curso.nivel || '—' %>
            </td>
            <td>
              <%= curso.fecha_inicio ? new Date(curso.fecha_inicio).toLocaleDateString('ca-ES', { day: '2-digit' ,
                month: '2-digit' , year: 'numeric' }) : '—' %>
            </td>
            <td>
              <%= curso.fecha_fin ? new Date(curso.fecha_fin).toLocaleDateString('ca-ES', { day: '2-digit' ,
                month: '2-digit' , year: 'numeric' }) : '—' %>
            </td>
            <td class="col-accions">
              <div class="acciones">
                <a href="/cursos/<%= curso.id %>" class="btn btn-secundario btn-sm">Editar</a>
              </div>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <div class="pagination-wrapper">
      <div class="pagination" aria-label="Paginació">
        <% if (pagination.currentPage > 1) { %>
          <a href="?page=<%= pagination.currentPage - 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            ← Anterior
          </a>
        <% } %>

        <span class="pagination-info">
          Pàgina <%= pagination.currentPage %> de <%= pagination.totalPages %>
          (<%= pagination.totalItems %> cursos)
        </span>

        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a href="?page=<%= pagination.currentPage + 1 %>&limit=<%= pagination.limit %>" class="btn btn-secundario btn-sm">
            Següent →
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

<% } else { %>
  <div class="empty-state">
    <p>No hi ha cursos registrats.</p>
    <a href="/cursos/nuevo" class="btn btn-primario">Crear el primer curs</a>
  </div>
<% } %>