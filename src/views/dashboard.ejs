<div class="page-header">
  <div>
    <h1 class="page-title">
      Benvingut, <%= usuario.nombre %>
        <%= usuario.apellidos %>
    </h1>

    <p class="page-subtitle">
      Resum de l'activitat:
    </p>
  </div>
</div>

<div class="dashboard-grid">

  <!-- ÚLTIMS ALUMNES -->
  <div class="dashboard-card">

    <div class="dashboard-card-header">
      <h2 class="dashboard-card-title">Últims alumnes</h2>
    </div>

    <% if (alumnos && alumnos.length> 0) { %>

      <div class="tabla-container">
        <table id="dashboardAlumnosTable">
          <thead>
            <tr>
              <th>Cognoms, Nom</th>
              <th>Tipus</th>
              <th>Data d'alta</th>
            </tr>
          </thead>

          <tbody>
            <% alumnos.forEach(alumno=> { %>
              <tr>

                <td>
                  <a class="alumno-nombre" href="/alumnos/<%= alumno.id %>">
                    <%= alumno.apellidos %>, <%= alumno.nombre %>
                  </a>
                </td>

                <td>
                  <span class="badge badge-<%= alumno.tipo %>">

                    <% if (alumno.tipo==='actual' ) { %>
                      Actual
                      <% } %>

                        <% if (alumno.tipo==='antiguo' ) { %>
                          Antic
                          <% } %>

                            <% if (alumno.tipo==='futuro' ) { %>
                              Futur
                              <% } %>

                  </span>
                </td>

                <td class="col-fecha">
                  <%= alumno.createdAt ? new Date(alumno.createdAt).toLocaleDateString('ca-ES', { day: '2-digit' ,
                    month: '2-digit' , year: 'numeric' }) : '—' %>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>

      <% } else { %>

        <div class="empty-state">
          <p>No hi ha alumnes registrats.</p>

          <a href="/alumnos/nuevo" class="btn btn-primario">
            Crear el primer alumne
          </a>
        </div>

        <% } %>

  </div>

  <!-- ÚLTIMS CURSOS -->
  <div class="dashboard-card">

    <div class="dashboard-card-header">
      <h2 class="dashboard-card-title">Últims cursos</h2>
    </div>

    <% if (cursos && cursos.length> 0) { %>

      <div class="tabla-container">
        <table id="dashboardCursosTable">
          <thead>
            <tr>
              <th>Codi</th>
              <th>Nom</th>
              <th>Data inici</th>
            </tr>
          </thead>

          <tbody>
            <% cursos.forEach(curso=> { %>
              <tr>

                <td>
                  <span class="curso-codigo">
                    <%= curso.codigo || '—' %>
                  </span>
                </td>

                <td>
                  <a class="curso-nombre" href="/cursos/<%= curso.id %>">
                    <%= curso.nombre %>
                  </a>
                </td>

                <td class="col-fecha">
                  <%= curso.fecha_inicio ? new Date(curso.fecha_inicio).toLocaleDateString( 'ca-ES' , { day: '2-digit' ,
                    month: '2-digit' , year: 'numeric' } ) : '—' %>
                </td>

              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>

      <% } else { %>

        <div class="empty-state">
          <p>No hi ha cursos registrats.</p>

          <a href="/cursos/nuevo" class="btn btn-primario">
            Crear el primer curs
          </a>
        </div>

        <% } %>

  </div>

</div>

<!-- ANOTACION USUARI -->

<div class="mostra-notes">


  <div class="notes-header">
    <h3 class="notes-title">Les meves anotacions</h3>

    <a href="/anotaciones/nueva" class="btn btn-primario">
      + Nova anotació
    </a>
  </div>

  <% if (anotaciones && anotaciones.length> 0) { %>

    <ul class="anotaciones-list">
      <% anotaciones.forEach(a=> { %>
        <li class="anotacion-item">

          <div class="anotacion-texto">
            <%= a.contenido %>
          </div>

          <div class="anotacion-fecha col-fecha">
            <%= new Date(a.created_at).toLocaleDateString('ca-ES', { day: '2-digit' , month: '2-digit' , year: 'numeric'
              }) %>
          </div>

        </li>
        <% }) %>
    </ul>

    <% } else { %>

      <div class="empty-state">
        <p>No hi ha anotacions encara.</p>
      </div>

      <% } %>

        <!-- PAGINACIÓN -->
        <% if (pagination && pagination.totalPages> 1) { %>

          <div class="notes-pag">

            <% if (pagination.currentPage> 1) { %>
              <a href="/dashboard?page=<%= pagination.currentPage - 1 %>" class="btn-sm">
                ← Anterior
              </a>
              <% } %>

                <span>
                  Página <%= pagination.currentPage %> de <%= pagination.totalPages %>
                </span>

                <% if (pagination.currentPage < pagination.totalPages) { %>
                  <a href="/dashboard?page=<%= pagination.currentPage + 1 %>" class="btn-sm">
                    Següent →
                  </a>
                  <% } %>

          </div>

          <% } %>

</div>