<form id="alumnoForm" data-id="<%= alumno.id %>" novalidate>

  <div class="page-header">
    <div>
      <a href="/alumnos" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Tornar al llistat
      </a>

      <h1 class="page-title form-group">
        <!-- modo vista -->
        <span class="view-mode">
          <%= alumno.nombre %>
            <%= alumno.apellidos %>
        </span>

        <!-- Modo edición -->

        <div class="edit-mode hidden form-group">
          <input type="text" name="nombre" value="<%= alumno.nombre %>" placeholder="Nom" required />
          <input type="text" name="apellidos" value="<%= alumno.apellidos %>" placeholder="Cognoms" required />
        </div>
      </h1>

      <p class="page-subtitle form-group">
        <!-- modo vista -->
        <span class="view-mode badge badge-<%= alumno.tipo %>">
          <% if (alumno.tipo==='actual' ) { %>Actual<% } %>
              <% if (alumno.tipo==='antiguo' ) { %>Antic<% } %>
                  <% if (alumno.tipo==='futuro' ) { %>Futur<% } %>
        </span>

        <!-- Modo edición -->
        <select name="tipo" class="edit-mode hidden form-group" required>
          <option value="actual" <%=alumno.tipo==='actual' ? 'selected' : '' %>>Actual</option>
          <option value="antiguo" <%=alumno.tipo==='antiguo' ? 'selected' : '' %>>Antic</option>
          <option value="futuro" <%=alumno.tipo==='futuro' ? 'selected' : '' %>>Futur</option>
        </select>
      </p>
    </div>
    <div class="acciones">
      <a href="#" id="btnEditar" class="btn btn-secundario">Editar</a>
      <button type="submit" id="btnGuardar" class="btn btn-secundario edit-mode hidden">Guardar</button>
      <button type="button" id="btnCancelar"
        class="btn btn-secundario cancelar-btn edit-mode hidden">Cancel·lar</button>
      <button type="button" class="btn btn-danger btn-eliminar" data-id="<%= alumno.id %>">Eliminar</button>
    </div>
  </div>

  <div class="detalle-grid form-group">
    <section class="detalle-card">
      <h2 class="detalle-card-title">Dades personals</h2>
      <dl class="detalle-list">
        <div class="detalle-item">
          <dt>DNI</dt>
          <dd>
            <span class="view-mode">
              <%= alumno.dni || '—' %>
            </span>
            <input type="text" id="DetAlDni" name="dni" value="<%= alumno.dni %>" class="edit-mode hidden"
              placeholder="DNI" required />
          </dd>
        </div>
        <div class="detalle-item">
          <dt>Email</dt>
          <dd>
            <span class="view-mode">
              <%= alumno.email || '—' %>
            </span>
            <input type="email" id="AlDeEmail" name="email" value="<%= alumno.email %>" class="edit-mode hidden"
              placeholder="Email" required />
          </dd>
        </div>
        <div class="detalle-item">
          <dt>Telèfon</dt>
          <dd>
            <span class="view-mode">
              <%= alumno.telefono || '—' %>
            </span>
            <input type="tel" name="telefono" value="<%= alumno.telefono %>" placeholder="Telèfon"
              class="edit-mode hidden" />
          </dd>
        </div>
        <div class="detalle-item">
          <dt>Nivell d'estudis</dt>
          <dd>
            <span class="view-mode">
              <%= alumno.nivel_estudios || '—' %>
            </span>
            <!-- MODO EDICIÓN -->
            <select name="nivel_estudios" class="edit-mode hidden" required>
              <option value="">Selecciona tipus</option>
              <option value="0" <%=alumno.nivel_estudios==0 ? 'selected' : '' %>>Sense estudis</option>
              <option value="1" <%=alumno.nivel_estudios==1 ? 'selected' : '' %>>Primària</option>
              <option value="2" <%=alumno.nivel_estudios==2 ? 'selected' : '' %>>Secundària</option>
              <option value="4" <%=alumno.nivel_estudios==4 ? 'selected' : '' %>>FP I</option>
              <option value="5" <%=alumno.nivel_estudios==5 ? 'selected' : '' %>>Batxillerat</option>
              <option value="6" <%=alumno.nivel_estudios==6 ? 'selected' : '' %>>FP II</option>
            </select>
          </dd>
        </div>
      </dl>
    </section>

    <section class="detalle-card">
      <h2 class="detalle-card-title">Autoritzacions</h2>
      <dl class="detalle-list">
        <div class="detalle-item">
          <dt>Drets d'imatge</dt>
          <dd>
            <span class="view-mode badge badge-<%= alumno.derechos_imagen ? 'actual' : 'antiguo' %>">
              <%= alumno.derechos_imagen ? 'Sí' : 'No' %>
            </span>
            <span class="edit-mode hidden radio-group">
              <label class="radio-option">
                <input type="radio" name="derechos_imagen" value="true" <%= alumno.derechos_imagen ? 'checked' : '' %> />
                <span class="badge badge-actual">Sí</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="derechos_imagen" value="false" <%= !alumno.derechos_imagen ? 'checked' : '' %> />
                <span class="badge badge-antiguo">No</span>
              </label>
            </span>
          </dd>
        </div>
        <div class="detalle-item">
          <dt>Cessió material</dt>
          <dd>
            <span class="view-mode badge badge-<%= alumno.cesion_material ? 'actual' : 'antiguo' %>">
              <%= alumno.cesion_material ? 'Sí' : 'No' %>
            </span>
            <span class="edit-mode hidden radio-group">
              <label class="radio-option">
                <input type="radio" name="cesion_material" value="true" <%= alumno.cesion_material ? 'checked' : '' %> />
                <span class="badge badge-actual">Sí</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="cesion_material" value="false" <%= !alumno.cesion_material ? 'checked' : '' %> />
                <span class="badge badge-antiguo">No</span>
              </label>
            </span>
          </dd>
        </div>
        <div class="detalle-item">
          <dt>Acció de difusió</dt>
          <dd>
            <span class="view-mode badge badge-<%= alumno.accion_difusion ? 'actual' : 'antiguo' %>">
              <%= alumno.accion_difusion ? 'Sí' : 'No' %>
            </span>
            <span class="edit-mode hidden radio-group">
              <label class="radio-option">
                <input type="radio" name="accion_difusion" value="true" <%= alumno.accion_difusion ? 'checked' : '' %> />
                <span class="badge badge-actual">Sí</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="accion_difusion" value="false" <%= !alumno.accion_difusion ? 'checked' : '' %> />
                <span class="badge badge-antiguo">No</span>
              </label>
            </span>
          </dd>
        </div>
      </dl>

    </section>

    <div id="AlDetMsg" class="form-msg form-full" aria-live="polite"></div>

    <section class="detalle-card detalle-full">
      <h2 class="detalle-card-title">Cursos</h2>
      <div class="card-header-cursos">
        <div class="header-actions">

          <button type="button" id="btnMostrarBuscador" class="btn btn-secundario js-open-matricula">
            Matricular en un curs
          </button>
          <button type="button" id="btnCancelarMatricula" class="btn btn-secundario cancelar-btn hidden">
            Cancel·lar
          </button>

        </div>
      </div>

      <ul class="detalle-cursos" id="listaCursos">
        <% if (alumno.Cursos && alumno.Cursos.length> 0) { %>
          <% alumno.Cursos.forEach(curso=> { %>
            <li class="alumno-curso-item">

              <span class="curso-codigo">
                <%= curso.codigo_curso %>
              </span>

              <span class="curso-nombre">
                <a class="curso-nombre-nuevo" href="/cursos/<%= curso.id %>">
                  <%= curso.nombre %>
                </a>
              </span>

              <span class="curso-fecha">
                Matrícula:
                <%= new Date(curso.curso_alumno.createdAt).toLocaleDateString("ca-ES") %>
              </span>

              <button type="button" class="btn btn-danger btn-desmatricular" data-curso-id="<%= curso.id %>"
                data-alumno-id="<%= alumno.id %>">
                Dar de baixa
              </button>


            </li>
            <% }) %>
              <% } else { %>
                <p class="detalle-empty" id="emptyCursos">
                  No està matriculat en cap curs.
                </p>
                <% } %>
      </ul>

      <div id="matriculaBox" class="matricula-box hidden">
            </li>
            <% }) %>
              <% } else { %>
                <p class="detalle-empty" id="emptyCursos">
                  No està matriculat en cap curs.
                </p>
                <% } %>
      </ul>

      <div id="matriculaBox" class="matricula-box hidden">

        <div class="buscador-wrapper">
          <div class="buscador-alumnos">
            <input type="text" id="buscarCurso" placeholder="Buscar curs..." autocomplete="off" />
          </div>
        </div>
        <div class="buscador-wrapper">
          <div class="buscador-alumnos">
            <input type="text" id="buscarCurso" placeholder="Buscar curs..." autocomplete="off" />
          </div>
        </div>

        <div id="resultadosCursos" class="dropdown hidden"></div>
        <div id="resultadosCursos" class="dropdown hidden"></div>

      </div>

    </section>
  </div>
</form>

<div class="detalle-grid form-group">
  <section class="detalle-card detalle-full">
    <h2 class="detalle-card-title">Documents</h2>

    <form class="document-form" data-entidad-tipo="Alumno" data-entidad-id="<%= alumno.id %>">
      <input type="file" name="archivo" required />
      <button type="submit" class="btn btn-secundario">
        Pujar document
      </button>
    </form>

    <ul class="detalle-lista-documentos">
      <p class="detalle-empty">Encara no hi ha documents.</p>
    </ul>
  </section>
</div>
